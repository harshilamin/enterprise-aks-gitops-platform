{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "environment",
        "logLevel"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "enum": [
            "local",
            "development",
            "qa",
            "production",
            "test"
          ]
        },
        "logLevel": {
          "enum": [
            "DEBUG",
            "INFO",
            "WARNING",
            "ERROR",
            "CRITICAL"
          ]
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "pullPolicy",
        "tag",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "create",
        "automount",
        "annotations",
        "name"
      ],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "automount": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "name": {
          "type": "string"
        }
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "service": {
      "type": "object",
      "required": [
        "type",
        "port",
        "annotations"
      ],
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "containerPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "probes": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "autoscaling": {
      "type": "object",
      "required": [
        "enabled",
        "minReplicas",
        "maxReplicas"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100
        },
        "targetMemoryUtilizationPercentage": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100
        },
        "behavior": {
          "type": "object"
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "maxUnavailable": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        }
      }
    },
    "networkPolicy": {
      "type": "object"
    },
    "ingress": {
      "type": "object"
    },
    "strategy": {
      "type": "object"
    },
    "revisionHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },
    "progressDeadlineSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "preStopSleepSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "enableServiceLinks": {
      "type": "boolean"
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraEnvFrom": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "priorityClassName": {
      "type": "string"
    },
    "helmTest": {
      "type": "object"
    },
    "workloadIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "clientId",
        "tenantId",
        "serviceAccountTokenExpirationSeconds"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "clientId": {
          "type": "string",
          "pattern": "^$|^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "tenantId": {
          "type": "string",
          "pattern": "^$|^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "serviceAccountTokenExpirationSeconds": {
          "type": "integer",
          "minimum": 3600,
          "maximum": 86400
        }
      }
    },
    "azureKeyVault": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "name",
        "cloudName",
        "mountPath",
        "objects"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "pattern": "^$|^[A-Za-z][A-Za-z0-9-]{1,22}[A-Za-z0-9]$"
        },
        "cloudName": {
          "type": "string"
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/[^\\s]*$"
        },
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "objectName"
            ],
            "properties": {
              "objectName": {
                "type": "string",
                "pattern": "^[A-Za-z0-9-]+$"
              },
              "objectVersion": {
                "type": "string"
              },
              "objectAlias": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$"
              }
            }
          }
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "serviceName",
        "otlp",
        "traces",
        "collector",
        "serviceMonitor",
        "prometheusRule",
        "grafanaDashboard"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "serviceName": {
          "type": "string",
          "minLength": 1
        },
        "otlp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "endpoint",
            "metricExportIntervalMs"
          ],
          "properties": {
            "endpoint": {
              "type": "string",
              "pattern": "^$|^https?://[^\\s]+$"
            },
            "metricExportIntervalMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 300000
            }
          }
        },
        "traces": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sampleRatio"
          ],
          "properties": {
            "sampleRatio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "collector": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "replicaCount",
            "image",
            "ports",
            "resources",
            "memoryLimitMiB",
            "replicasForPdb",
            "podDisruptionBudget",
            "securityContext",
            "podSecurityContext"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "replicaCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "image": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repository",
                "tag",
                "digest",
                "pullPolicy"
              ],
              "properties": {
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "tag": {
                  "type": "string"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^$|^sha256:[a-f0-9]{64}$"
                },
                "pullPolicy": {
                  "type": "string",
                  "enum": [
                    "Always",
                    "IfNotPresent",
                    "Never"
                  ]
                }
              }
            },
            "ports": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "otlpGrpc",
                "otlpHttp",
                "prometheus",
                "telemetry",
                "health"
              ],
              "properties": {
                "otlpGrpc": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "otlpHttp": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "prometheus": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "telemetry": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "health": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            },
            "resources": {
              "type": "object"
            },
            "memoryLimitMiB": {
              "type": "integer",
              "minimum": 128,
              "maximum": 4096
            },
            "replicasForPdb": {
              "type": "integer",
              "minimum": 2,
              "maximum": 10
            },
            "podDisruptionBudget": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "minAvailable"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "minAvailable": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "securityContext": {
              "type": "object"
            },
            "podSecurityContext": {
              "type": "object"
            }
          }
        },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "interval",
            "scrapeTimeout",
            "additionalLabels"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string",
              "pattern": "^[0-9]+(ms|s|m|h)$"
            },
            "scrapeTimeout": {
              "type": "string",
              "pattern": "^[0-9]+(ms|s|m|h)$"
            },
            "additionalLabels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "prometheusRule": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "additionalLabels",
            "availabilityTarget",
            "latencyThresholdSeconds"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "additionalLabels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "availabilityTarget": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "latencyThresholdSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "grafanaDashboard": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "labels"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "app",
    "replicaCount",
    "image",
    "serviceAccount",
    "service",
    "containerPort",
    "probes",
    "resources",
    "autoscaling",
    "podDisruptionBudget",
    "networkPolicy",
    "ingress",
    "observability"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "workloadIdentity": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "serviceAccount": {
            "properties": {
              "create": {
                "const": true
              }
            }
          },
          "workloadIdentity": {
            "properties": {
              "clientId": {
                "minLength": 36
              },
              "tenantId": {
                "minLength": 36
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "azureKeyVault": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "workloadIdentity": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "azureKeyVault": {
            "properties": {
              "name": {
                "minLength": 3
              },
              "objects": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ]
}
